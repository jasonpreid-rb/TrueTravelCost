# Required: your OpenAI API key. Set this in Vercel's Environment
# Variables (Project Settings -> Environment Variables), never commit
# a real key to a file or a git repo.
OPENAI_API_KEY=sk-...

# Optional: override the model used for cost estimates. Defaults to
# gpt-5-mini if unset. Check OpenAI's current model list before
# changing this, since names and availability shift over time.
OPENAI_MODEL=gpt-5-mini
